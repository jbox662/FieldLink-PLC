[Unit]
Description=FieldLink Gateway commissioning boundary
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fieldlink-gateway
ExecStart=/usr/bin/python3 -m fieldlink_gateway --data-dir /var/lib/fieldlink-gateway --plant-iface eth0 --listen 0.0.0.0:8443
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
